{
  "version": 2,
  "builds": [
    {
      "src": "quote.js",
      "use": "@vercel/node"
    },
    {
      "src": "checkout.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "order.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "order.js",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/quote",
      "dest": "/quote.js"
    },
    {
      "src": "/api/checkout",
      "dest": "/checkout.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
